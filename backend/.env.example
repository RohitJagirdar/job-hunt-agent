# AI provider: Claude is tried first and Gemini is the fallback. Set either key (or both).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# auto = Claude then Gemini | anthropic = Claude only | gemini = Gemini only
LLM_PROVIDER=auto
# Optional model overrides
ANTHROPIC_PROFILE_MODEL=claude-sonnet-5-5
ANTHROPIC_SCORING_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.8-flash
BRAVE_SEARCH_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
DATABASE_URL=sqlite:///./job_hunter.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
